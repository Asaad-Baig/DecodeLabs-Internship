import tkinter as tk
from tkinter import messagebox


def add_task():
    task_text = task_entry.get()
    
    if task_text != "":
        tasks.append(task_text)  
        update_task_display()
        task_entry.delete(0, tk.END)  
    else:
        messagebox.showwarning("Warning", "You must enter a task.")

def update_task_display():
    task_listbox.delete(0, tk.END)  
    
    for index, task in enumerate(tasks):
        task_listbox.insert(tk.END, f"{index + 1}. {task}")


tasks = []

root = tk.Tk()
root.title("Task Manager")
root.geometry("350x450")
root.config(bg="#f0f4f8")


title_label = tk.Label(root, text="My Tasks", font=("Helvetica", 18, "bold"), bg="#f0f4f8", fg="#333333")
title_label.pack(pady=(20, 10))

task_entry = tk.Entry(root, width=30, font=("Helvetica", 12))
task_entry.pack(pady=10)

add_button = tk.Button(root, text="Add Task", command=add_task, font=("Helvetica", 12, "bold"), bg="#4CAF50", fg="white", relief="flat")
add_button.pack(pady=5)

task_listbox = tk.Listbox(root, width=35, height=12, font=("Helvetica", 11), selectbackground="#d3d3d3", relief="groove")
task_listbox.pack(pady=15)

if __name__ == "__main__":
    root.mainloop()